=== الكود الواحد لكل البلوكشينات ===

// هذا العقد يشتغل على كل البلوكشينات الـ 8 بنفس الكود
// Solidity - EVM Compatible

contract UniversalPhoneLock {
    bool public isLocked = true;
    uint256 public phoneBlock = 128924667;
    address public phoneMaster = 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266;

    // يمنع إنشاء عملات نصب على أي بلوكشين
    mapping(address => bool) public blockedScam;

    function blockScamCoin(address scam) external {
        require(msg.sender == phoneMaster, "Only Phone Master");
        blockedScam[scam] = true;
    }

    // نفس الكود على BSC, ETH, Polygon, Arbitrum...
}
    

=== ازاي تبرمج على الكل مرة واحدة؟ ===
1. اكتب الكود مرة واحدة (زي فوق)
2. npx hardhat deploy --network bsc → يتنشر على BSC
3. npx hardhat deploy --network eth → نفس الكود على ETH
4. نفس الكود على هاتفك: node instant-lock.js

